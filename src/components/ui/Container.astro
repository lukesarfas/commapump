---
// Vendored from @sarfas/ui.
interface Props {
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}
const { as: Tag = "div", class: className } = Astro.props;
---

<Tag class:list={["sarfas-container", className]}>
  <slot />
</Tag>

<style>
  .sarfas-container {
    max-width: var(--maxw, 1140px);
    margin: 0 auto;
    padding: 0 1.25rem;
  }
</style>
