---
import Base from "~/layouts/Base.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import Container from "~/components/ui/Container.astro";
import Button from "~/components/ui/Button.astro";
import { schedule, PUMP_IVIIVI, SYNTONIC_COMMA_CENTS } from "~/core/index";
import { SCENES } from "~/content/beats";
import { GLOSSARY } from "~/content/glossary";

// Hero drift staircase, rendered at build time from the verified engine.
const result = schedule(PUMP_IVIIVI, { cycles: 4 });
const homes = result.notes.filter((n) => n.isCycleTonic).map((n) => n.centsVsET);
const W = 760;
const H = 300;
const padX = 64;
const padTop = 28;
const padBottom = 40;
const minC = Math.min(0, ...homes) - 8;
const maxC = 8;
const yOf = (c: number) => padTop + ((maxC - c) / (maxC - minC)) * (H - padTop - padBottom);
const stepW = (W - padX * 2) / Math.max(1, homes.length - 1);
const points = homes.map((c, i) => ({ x: padX + i * stepW, y: yOf(c), c, i }));
const path = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(" ");

const PUMP_ABC = `X:1\nM:4/4\nL:1/1\nK:C\n"C" [C,EG] | "Am" [C,EA] | "Dm" [D,FA] | "G" [G,Bd] | "C" [C,EG] |]`;
const FIFTHS_ABC = `X:1\nM:4/4\nL:1/4\nK:C\nC G d a | e2 C2 |]`;
---

<Base>
  <Header />
  <main id="main" tabindex="-1">
    <section class="hero">
      <Container>
        <p class="eyebrow">The comma pump · syntonic comma drift</p>
        <h1>
          Play a chord loop that's <em>perfectly</em> in tune,<br />
          and the key <span class="text-gradient">sinks</span>.
        </h1>
        <p class="prose lede">
          In pure just intonation, the progression <strong>I–vi–ii–V–I</strong> — every fifth and
          third a beat-free whole-number ratio — doesn't come home. Each lap, the tonic drops by a
          <strong>syntonic comma</strong> ({SYNTONIC_COMMA_CENTS.toFixed(1)}¢, about a fifth of a
          semitone). Nothing is out of tune; tuning itself just doesn't add up.
        </p>

        <figure class="ribbon">
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Each loop of the progression sinks the tonic by one syntonic comma.">
            <line x1={padX} x2={W - padX} y1={yOf(0)} y2={yOf(0)} class="zero" />
            <text x={padX} y={yOf(0) - 8} class="zero-label">in tune · 0¢</text>
            <path d={path} class="stair" />
            {points.map((p) => (
              <g>
                <circle cx={p.x} cy={p.y} r="5" class="node" />
                <text x={p.x} y={p.y + 22} class="cents">{p.c.toFixed(1)}¢</text>
                <text x={p.x} y={p.y - 12} class="loop">{p.i === 0 ? "start" : `loop ${p.i}`}</text>
              </g>
            ))}
          </svg>
          <figcaption>Four loops of I–vi–ii–V–I in just intonation — the tonic “C” after each return.</figcaption>
        </figure>

        <div class="cta">
          <Button href="#story" variant="primary">Walk through it →</Button>
          <Button href="#playground">Skip to the playground</Button>
        </div>
      </Container>
    </section>

    <section id="story" class="lab-section">
      <Container>
        <div class="lab-layout">
          <div class="lab-figure" aria-label="The comma-pump lab" role="group">
            <div id="lab-tabs" class="switch" role="tablist" aria-label="Choose a visualization"></div>
            <div id="lab-stage" class="stage" role="tabpanel" tabindex="0" aria-label="Visualization">
              {/* Replaced by the engine once the first visualization mounts. */}
              <div class="stage-loading" data-testid="lab-stage-loading">
                <span class="spinner" aria-hidden="true"></span>
                <span>Loading the lab…</span>
              </div>
            </div>
            {/*
              Audio-capability slot. Hidden by default; the engine (UI-engine)
              removes the [hidden] attribute when it detects that Web Audio is
              unavailable in this browser. role="alert" announces it on reveal.
            */}
            <p id="lab-audio-unavailable" class="audio-warning" role="alert" data-testid="lab-audio-unavailable" hidden>
              Audio isn't available in this browser, so the lab is silent — the
              visualizations and the drift readout still work.
            </p>
            <div class="lab-caption">
              <p id="lab-example-note" class="example-note" data-testid="lab-example-note"></p>
              <p id="lab-howto" class="howto" data-testid="lab-howto"></p>
            </div>
            <div class="lab-bar">
              <button id="lab-play" type="button" class="btn primary">▶ Play</button>
              <div id="lab-readout" class="readout" aria-live="off"></div>
              <button id="lab-mode" type="button" class="btn" aria-pressed="false" aria-label="Toggle tuning between just intonation and equal temperament">Just intonation</button>
            </div>
            <p id="lab-live" class="sr-only" aria-live="polite"></p>
          </div>

          <div class="lab-steps">
            {SCENES.map((scene) => (
              <article class="step" data-scene={scene.id}>
                <h2>{scene.title}</h2>
                <Fragment set:html={scene.body} />
              </article>
            ))}

            <article class="step playground" id="playground" data-scene="playground-anchor">
              <h2>Your turn</h2>
              <p>Pick an example, switch tuning, and let the drift accumulate — the lab updates live.</p>
              <div id="lab-examples" class="chips" role="group" aria-label="Choose an example progression"></div>
              <div class="controls">
                <label for="lab-cycles">
                  Loops
                  <input id="lab-cycles" type="range" min="1" max="6" value="4" />
                  <span id="lab-cycles-out" class="num" aria-hidden="true">4</span>
                </label>
                <label for="lab-tempo">
                  Tempo
                  <input id="lab-tempo" type="range" min="50" max="140" value="90" />
                </label>
              </div>
              <p class="hint">Tip: play the pump in <strong>just intonation</strong>, then press the tuning button to hear it stop drifting in equal temperament.</p>
            </article>
          </div>
        </div>
      </Container>
    </section>

    <section class="section">
      <Container>
        <h2>On the page</h2>
        <p class="prose muted">The two worked examples, engraved. Tuning lives in the ratios, not the notation — these are the notes; the lab decides how to tune them.</p>
        <div class="scores">
          <figure>
            <figcaption>The pump — I–vi–ii–V–I</figcaption>
            <div class="score" data-abc={PUMP_ABC}>
              <p class="score-loading">Engraving notation…</p>
            </div>
          </figure>
          <figure>
            <figcaption>The fifths chain — C–G–D–A–E–C</figcaption>
            <div class="score" data-abc={FIFTHS_ABC}>
              <p class="score-loading">Engraving notation…</p>
            </div>
          </figure>
        </div>
      </Container>
    </section>

    <section class="section">
      <Container>
        <h2>Glossary</h2>
        <dl class="glossary">
          {GLOSSARY.map((g) => (
            <div>
              <dt>{g.term}</dt>
              <dd>{g.def}</dd>
            </div>
          ))}
        </dl>
        <p class="prose muted sources">
          Sources: Wikipedia (Syntonic comma), FIU Just Intonation (Pitch Drift), John Baez’s Azimuth,
          tonalsoft, and Ross Duffin, “Just Intonation in Renaissance Theory and Practice” (MTO 12.3, 2006).
        </p>
      </Container>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import "~/site/lab.ts";
  import "~/site/notation.ts";
</script>

<style>
  .hero {
    padding: clamp(2.5rem, 7vw, 5.5rem) 0 2rem;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 3.6rem);
    margin: 0 0 1.25rem;
  }
  h1 em {
    font-style: italic;
    color: var(--fg-soft);
  }
  .lede {
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: var(--fg-soft);
  }
  .ribbon {
    margin: 2.5rem 0 2rem;
    max-width: 820px;
  }
  .ribbon svg {
    width: 100%;
    height: auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .ribbon figcaption {
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }
  .zero { stroke: var(--et); stroke-width: 1; stroke-dasharray: 4 5; opacity: 0.6; }
  .zero-label { fill: var(--et); font-size: 12px; opacity: 0.85; }
  .stair { fill: none; stroke: var(--signature); stroke-width: 2.5; stroke-linejoin: round; stroke-linecap: round; }
  .node { fill: var(--signature); }
  .cents { fill: var(--fg); font-size: 12px; text-anchor: middle; font-variant-numeric: tabular-nums; }
  .loop { fill: var(--muted); font-size: 11px; text-anchor: middle; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ---- the lab (scroll-story + playground) ---- */
  .lab-section { padding: 2rem 0 3rem; }
  .lab-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .lab-figure {
    position: sticky;
    /* Vertically centre the lab in the viewport so it lines up with the
       centred prose beside it, instead of clinging to the top. */
    top: clamp(72px, calc(50vh - 320px), 220px);
    z-index: 1;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 0.75rem;
    box-shadow: var(--shadow);
  }
  .stage {
    aspect-ratio: 16 / 10;
    width: 100%;
    background: var(--bg);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stage svg { width: 100%; height: 100%; display: block; }
  .stage-loading {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .spinner {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    border-top-color: var(--signature);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .audio-warning {
    margin: 0.6rem 0 0;
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--signature-warm) 45%, var(--border-strong));
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--signature-warm) 10%, transparent);
    color: var(--fg-soft);
    font-size: 0.85rem;
  }

  .switch { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 0.6rem; }
  .lab-bar { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.6rem; flex-wrap: wrap; }
  .readout { color: var(--signature); font-weight: 600; font-variant-numeric: tabular-nums; font-size: 0.9rem; margin-right: auto; }
  .lab-caption {
    margin: 0.7rem 0 0;
    padding: 0.75rem 0.9rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid color-mix(in oklab, var(--signature) 70%, transparent);
    border-radius: 0 10px 10px 0;
  }
  .example-note {
    margin: 0;
    color: var(--fg);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .example-note :global(strong) { color: var(--signature); font-weight: 600; }
  .howto {
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .howto:empty,
  .example-note:empty { display: none; }

  .lab-steps { display: flex; flex-direction: column; }
  .step {
    min-height: 68vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 0;
    max-width: 52ch;
  }
  .step h2 { font-size: clamp(1.7rem, 4vw, 2.6rem); margin-bottom: 1rem; }
  .step :global(p) {
    color: var(--fg-soft);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.7;
  }
  .step :global(p + p) { margin-top: 0.9rem; }
  .step.playground { min-height: auto; padding: 2rem 0 3rem; }

  .chips { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0; }
  .controls { display: flex; gap: 1.5rem; flex-wrap: wrap; margin: 0.5rem 0 1rem; align-items: center; }
  .controls label { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--muted); font-size: 0.9rem; }
  .num { color: var(--fg); font-variant-numeric: tabular-nums; }
  .hint { font-size: 0.9rem; color: var(--muted); }

  /* ---- buttons used by lab.ts ---- */
  .btn {
    appearance: none;
    border: 1px solid var(--border-strong);
    background: var(--card);
    color: var(--fg);
    border-radius: 10px;
    padding: 0.5rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    min-height: 40px;
  }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--grad-1); color: #1a140a; border-color: transparent; font-weight: 600; }
  .btn[aria-pressed="true"] { border-color: var(--et); color: var(--et); }
  /* A disabled control must read as dead, not fully active (SPEC §4.3). */
  .btn:disabled,
  .btn[aria-disabled="true"] { opacity: 0.55; cursor: not-allowed; filter: grayscale(0.3); }
  .btn:disabled:hover,
  .btn[aria-disabled="true"]:hover { border-color: var(--border-strong); }
  .tab {
    appearance: none;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    border-radius: 8px;
    padding: 0.35rem 0.65rem;
    font-size: 0.82rem;
    cursor: pointer;
    min-height: 34px;
  }
  .tab[aria-selected="true"] { color: var(--fg); border-color: var(--signature); background: var(--card); }
  .chip {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg-soft);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    cursor: pointer;
  }
  .chip[aria-pressed="true"] { border-color: var(--signature); color: var(--fg); }

  .section { padding: 3rem 0; border-top: 1px solid var(--border); }
  .section h2 { font-size: clamp(1.4rem, 3vw, 2rem); margin-bottom: 1rem; }
  .muted { color: var(--muted); }
  .scores { display: grid; gap: 1.5rem; margin-top: 1.5rem; }
  .score { background: #faf8f2; color: #1a1814; border-radius: var(--radius); padding: 0.5rem 1rem; overflow-x: auto; }
  /* abcjs injects an SVG at runtime; force its ink dark so the engraving is
     visible on the cream paper (it otherwise inherits the dark theme's light fg). */
  .score :global(svg) { color: #1a1814; }
  .score :global(svg path) { fill: #1a1814; }
  .score :global(svg text),
  .score :global(svg tspan) { fill: #1a1814; }
  .score-loading { color: #6b6457; font-size: 0.85rem; margin: 0.5rem 0; }
  figure { margin: 0; }
  figcaption { color: var(--muted); font-size: 0.85rem; margin-bottom: 0.5rem; }

  .glossary { display: grid; gap: 1rem; max-width: var(--maxw-prose); }
  .glossary dt { font-weight: 600; color: var(--fg); }
  .glossary dd { margin: 0.15rem 0 0; color: var(--muted); }
  .sources { margin-top: 2rem; font-size: 0.85rem; }

  @media (min-width: 900px) {
    .lab-layout { grid-template-columns: 1.05fr 0.95fr; }
    .lab-figure { order: 2; align-self: start; }
    .lab-steps { order: 1; }
    .scores { grid-template-columns: 1fr 1fr; }
  }

  /* Phones: let the lab scroll with the prose instead of pinning it — a sticky
     16:10 stage would otherwise cover most of the viewport and hide the steps.
     Steps lose their tall min-height so the page reads as a normal column. */
  @media (max-width: 480px) {
    .lab-figure {
      position: static;
      top: auto;
    }
    .step {
      min-height: auto;
      padding: 1.25rem 0;
      max-width: none;
    }
    .lab-bar { gap: 0.5rem; }
    .lab-bar .btn { flex: 1 1 auto; }
    .readout {
      flex-basis: 100%;
      margin-right: 0;
      order: 3;
    }
    .controls { gap: 1rem; }
    .controls label { flex: 1 1 100%; }
    .controls input[type="range"] { flex: 1 1 auto; min-width: 0; }
    .cta :global(.sarfas-btn) { flex: 1 1 auto; justify-content: center; }
  }

  /* The spinner is the one looping animation in the lab; stop it for reduced
     motion (the global rule already neutralizes transitions, but the spinner's
     duration override would still leave it visibly spinning). */
  @media (prefers-reduced-motion: reduce) {
    .spinner { animation: none; }
  }
</style>
